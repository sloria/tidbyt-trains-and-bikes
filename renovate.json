{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "schedule:monthly"],
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "schedule": ["before 3am on the first day of the month"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "all dependencies"
    }
  ]
}
